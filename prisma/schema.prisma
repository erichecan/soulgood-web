// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  MEMBER
  ADMIN
}

enum MemberTier {
  NORMAL
  VIP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // 邮箱密码登录；迁移用户首次登录需重设密码
  needsReset    Boolean   @default(false) // WP 迁移账号首次登录强制重设密码
  googleId      String?   @unique // Gmail 一键登录
  role          Role      @default(GUEST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions MembershipSubscription[]
  enrollments   Enrollment[]
  certificates  Certificate[]
}

model MembershipSubscription {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  tier      MemberTier
  status    String // active / expired / cancelled
  startedAt DateTime
  expiresAt DateTime?

  @@index([userId])
}

model Course {
  id                String    @id @default(cuid())
  slug              String    @unique
  titleEn           String?
  titleZh           String?
  descriptionEn     String?
  descriptionZh     String?
  whatYoullLearnEn  String?
  whatYoullLearnZh  String?
  price             Decimal
  compareAtPrice    Decimal?
  level             String?
  thumbnailUrl      String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollments   Enrollment[]
  certificates  Certificate[]
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  status      String // enrolled / completed
  purchasedAt DateTime

  @@index([userId])
  @@index([courseId])
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleEn       String?
  titleZh       String?
  contentEn     String?
  contentZh     String?
  coverImageUrl String?
  author        String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Partner {
  id        String @id @default(cuid())
  name      String
  logoUrl   String
  linkUrl   String
  sortOrder Int    @default(0)
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String // percentage / fixed
  discountValue Decimal
  appliesTo     String // course / membership / all
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  issuedAt        DateTime @default(now())
  certificateUrl  String?

  @@index([userId])
  @@index([courseId])
}
